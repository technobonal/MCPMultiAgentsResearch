# Copia este archivo a .env y completa los valores. NO subas .env a Git.

# --- LLM (Groq) ---
GROQ_API_KEY=
# Opcional: cadena de fallback separada por comas
# GROQ_MODEL_CHAIN=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b

# --- Login con Google (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Único email autorizado a entrar
ALLOWED_EMAIL=
# Cadena aleatoria larga para firmar la sesión
SESSION_SECRET_KEY=
FRONTEND_URL=http://localhost:3000

